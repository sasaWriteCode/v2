---
/**
 * FaqSection — native <details> accordion, zero JS. Every question and
 * answer is in the SSR DOM (SEO-bearing); SolutionTemplate lifts the same
 * items into FAQPage JSON-LD. Funnel role: clear the last doubts right
 * before the CTA.
 */
import type { FaqContent } from '@/types/sections';

type Props = FaqContent;
const { heading, lede, items } = Astro.props;
---

<div>
  {heading && <h2 class="type-heading-lg">{heading}</h2>}
  {lede && (
    <p class="type-body-md mt-2 max-w-article" style="color: var(--text-secondary)">
      {lede}
    </p>
  )}
  <div class:list={['grid gap-3', (heading || lede) && 'mt-8']}>
    {items.map((item) => (
      <details
        class="faq-item rounded-lg"
        style="background: var(--surface-raised); border: 1px solid var(--border-subtle)"
      >
        <summary class="type-body-md flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold">
          {item.question}
          <span class="faq-marker" aria-hidden="true">+</span>
        </summary>
        <p class="type-body-md max-w-article px-5 pb-5" style="color: var(--text-secondary)">
          {item.answer}
        </p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary {
    list-style: none;
  }
  .faq-marker {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-default);
    color: var(--color-red-brand);
    font-weight: 600;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .faq-item[open] .faq-marker {
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-marker {
      transition: none;
    }
  }
</style>
