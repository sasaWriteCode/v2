---
/**
 * CategoryGrid — icon link-cards into knowledge categories. Static.
 */
import { Icon } from '@/components/global/Icon';
import type { CategoryGridContent } from '@/types/sections';
import { resolveUrl } from '@/lib/paths';

type Props = CategoryGridContent;
const { heading, lede, layout = 'grid', categories } = Astro.props;
const masonry = layout === 'masonry';
const gridColsClass =
  categories.length === 5
    ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5'
    : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4';

const DEFAULT_IMAGES: Record<string, string> = {
  car: '/images/automotive-tint.png',
  home: '/images/residential-glass.png',
  building: '/images/commercial-building.png',
  person: '/images/hero-sunlight.png',
  leaf: '/images/esg-env-banner.png',
};

const DEFAULT_COLORS: Record<string, string> = {
  car: '#ef4444',      // Automotive -> Red
  home: '#eab308',     // Residential -> Yellow
  building: '#2563eb', // Commercial -> Corporate Blue
  person: '#c084fc',   // Personal Care -> Light Purple
  leaf: '#22c55e',     // Sustainability -> Grass Green
};
---

<div>
  {heading && <h2 class="type-heading-lg">{heading}</h2>}
  {lede && (
    <p class="type-body-md mt-2 max-w-article" style="color: var(--text-secondary)">
      {lede}
    </p>
  )}
  <ul
    class:list={[
      masonry ? 'category-masonry' : `grid gap-5 ${gridColsClass}`,
      (heading || lede) && 'mt-8',
    ]}
  >
    {categories.map((category) => {
      const rawImage = typeof category.image === 'object' ? category.image.src : (category.image || DEFAULT_IMAGES[category.icon]);
      const imgSrc = rawImage ? resolveUrl(rawImage) : null;
      const href = resolveUrl(category.href);
      const iconColor = category.iconColor || DEFAULT_COLORS[category.icon] || 'var(--text-brand)';

      return (
        <li>
          <a
            href={href}
            class:list={[
              'group relative flex flex-col items-center justify-between text-center rounded-2xl p-6 overflow-hidden transition-all duration-300 ease-out hover:shadow-2xl hover:-translate-y-1',
              !masonry && 'min-h-[370px]',
            ]}
            style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1); color: inherit; text-decoration: none"
          >
            {/* Background Image Layer */}
            {imgSrc && (
              <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
                <img
                  src={imgSrc}
                  alt=""
                  class="h-full w-full object-cover opacity-45 scale-100 transition-all duration-700 ease-out group-hover:opacity-70 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/65 to-black/90 opacity-90 transition-opacity duration-500 group-hover:opacity-75 z-0" />
                <div
                  class="absolute inset-0 opacity-25 transition-opacity duration-500 group-hover:opacity-40 z-0"
                  style={`background: radial-gradient(circle at top center, ${iconColor} 0%, transparent 75%)`}
                />
              </div>
            )}

            {/* Top / Center Section: Icon + Title + Description */}
            <div class="relative z-10 flex flex-col items-center text-center gap-3 w-full">
              {/* Circular Icon Ring */}
              <div
                class="flex items-center justify-center w-16 h-16 rounded-full border-2 border-white/90 shadow-lg transition-all duration-300 group-hover:scale-110 group-hover:border-white group-hover:shadow-white/20"
                style={`background: ${iconColor}45; color: #ffffff`}
              >
                <Icon name={category.icon} size={28} />
              </div>

              {/* Uppercase Title */}
              <h3 class="text-base sm:text-lg font-bold tracking-widest text-white uppercase mt-1 transition-transform duration-300 group-hover:scale-105">
                {category.title}
              </h3>

              {/* Description */}
              {category.description && (
                <p class="text-xs sm:text-sm text-zinc-200 leading-relaxed max-w-[240px] transition-colors duration-300 group-hover:text-white">
                  {category.description}
                </p>
              )}

              {category.count && (
                <span class="text-xs text-zinc-400 mt-1 transition-colors duration-300 group-hover:text-zinc-200">
                  {category.count}
                </span>
              )}
            </div>

            {/* Bottom Circle Arrow Button */}
            <div class="relative z-10 mt-6 flex items-center justify-center w-10 h-10 rounded-full border border-white/80 text-white transition-all duration-300 group-hover:border-white group-hover:bg-white group-hover:text-black group-hover:scale-110 shadow-md">
              <svg
                class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<style>
  /* ── Masonry variant (layout: 'masonry') ──
     Pure CSS columns — items flow down each column, zero JS. A repeating
     4-step height rhythm (tall/short/medium/tall) gives the staggered
     Pinterest look; without it, equal cards would just look like a grid
     with misaligned rows. */
  .category-masonry {
    columns: 1;
    column-gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .category-masonry {
      columns: 2;
    }
  }
  @media (min-width: 64rem) {
    .category-masonry {
      columns: 3;
    }
  }
  .category-masonry > li {
    break-inside: avoid;
    margin-bottom: 1.25rem;
  }
  .category-masonry > li:nth-child(4n + 1) a {
    min-height: 26rem;
  }
  .category-masonry > li:nth-child(4n + 2) a {
    min-height: 18rem;
  }
  .category-masonry > li:nth-child(4n + 3) a {
    min-height: 22rem;
  }
  .category-masonry > li:nth-child(4n + 4) a {
    min-height: 30rem;
  }
</style>
