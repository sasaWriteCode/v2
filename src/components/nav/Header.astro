---
/**
 * Header — sticky (position: sticky only — it never listens to or re-times
 * scroll). Desktop: inline nav from src/config/navigation.ts. Mobile: the
 * MobileNav native-dialog component (vanilla ~1KB script — see its header
 * for why it is deliberately NOT a React island).
 */
import MobileNav from "@/components/nav/MobileNav.astro";
import {
  BRAND,
  NAV_CTA,
  NAV_EWARRANTY,
  NAV_STRINGS,
  PRIMARY_NAV,
} from "@/config/navigation";
import { resolveUrl } from "@/lib/paths";
---

<header class="site-header">
  <div
    class="container flex items-center justify-between gap-4"
    style="height: var(--header-height)"
  >
    <a
      href={resolveUrl(BRAND.href)}
      class="flex items-center gap-2.5"
      style="text-decoration: none"
      aria-label="IrisPro Home"
    >
      <img
        src={resolveUrl("/irispro-logo.png")}
        alt="IrisPro Logo"
        style="height: 28px; width: auto; display: block; object-fit: contain;"
      />
    </a>

    <nav aria-label={NAV_STRINGS.primaryNavLabel} class="hidden lg:block">
      <ul class="flex items-center gap-5">
        {
          PRIMARY_NAV.map((item) => {
            const menuItems = (item.children ?? []).filter(
              (child) => child.headerMenu,
            );
            return (
              <li class={menuItems.length > 0 ? "nav-item has-menu" : "nav-item"}>
                <a
                  href={resolveUrl(item.href)}
                  class="type-body-sm nav-item-link font-medium"
                  style="color: var(--text-secondary); text-decoration: none"
                >
                  {item.label}
                  {menuItems.length > 0 && (
                    <svg
                      class="nav-item-chevron"
                      aria-hidden="true"
                      width="10"
                      height="10"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  )}
                </a>
                {menuItems.length > 0 && (
                  <div class="nav-menu">
                    <ul class="nav-menu-panel">
                      {menuItems.map((child) => (
                        <li>
                          <a
                            href={resolveUrl(child.href)}
                            class="type-body-sm nav-menu-link"
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={NAV_EWARRANTY.href}
        target="_blank"
        rel="noopener"
        class="btn-press type-body-sm hidden rounded-md px-4 py-2 font-semibold sm:inline-block"
        style="border: 1px solid var(--border-subtle); color: var(--text-secondary); text-decoration: none"
      >
        {NAV_EWARRANTY.label}
      </a>
      <a
        href={resolveUrl(NAV_CTA.href)}
        class="btn-press type-body-sm hidden rounded-md px-4 py-2 font-semibold sm:inline-block"
        style="background: var(--color-red); color: var(--color-white); text-decoration: none"
      >
        {NAV_CTA.label}
      </a>
      <span class="lg:hidden">
        <MobileNav />
      </span>
    </div>
  </div>
</header>

<style>
  .nav-item {
    position: relative;
  }
  .nav-item-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .nav-item-chevron {
    transition: transform 150ms ease;
  }
  .has-menu:hover .nav-item-chevron,
  .has-menu:focus-within .nav-item-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown — pure CSS, opens on hover and keyboard focus. The panel sits
     inside a padded wrapper so the pointer never crosses a dead gap. */
  .nav-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding-top: 0.75rem;
    display: none;
    z-index: 60;
  }
  .has-menu:hover .nav-menu,
  .has-menu:focus-within .nav-menu {
    display: block;
  }
  .nav-menu-panel {
    list-style: none;
    margin: 0;
    min-width: 13.5rem;
    padding: 0.4rem;
    background: var(--surface-base);
    border: 1px solid var(--border-subtle);
    border-radius: 0.6rem;
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.18);
  }
  .nav-menu-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.4rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .nav-menu-link:hover,
  .nav-menu-link:focus-visible {
    color: var(--text-primary);
    background: var(--surface-sunken, rgb(0 0 0 / 0.04));
  }
</style>
